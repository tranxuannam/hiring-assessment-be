APP_NAME=Hiring Assessment API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./hiring_assessment.db
SQL_ECHO=false

# Required when using the production LLM scoring client.
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_PROMPT_VERSION=v1
LLM_MAX_ATTEMPTS=3
CANDIDATE_LINK_SECRET=replace-with-a-random-secret
HR_MOCK_TOKEN=development-only-mock-token
UPLOAD_DIRECTORY=./uploads
